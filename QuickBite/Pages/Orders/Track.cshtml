@page "/Orders/Track"
@model QuickBite.Pages.Orders.TrackModel
@using QuickBite.Models
@{
    ViewData["Title"] = "Theo dõi đơn hàng";
    var order = Model.Order;
    var isDelivery = order?.OrderType == OrderType.Delivery;
    var progressStatuses = isDelivery
        ? new[] { OrderStatus.Pending, OrderStatus.Confirmed, OrderStatus.Preparing, OrderStatus.Ready, OrderStatus.Delivering, OrderStatus.Completed }
        : new[] { OrderStatus.Pending, OrderStatus.Confirmed, OrderStatus.Preparing, OrderStatus.Ready, OrderStatus.Completed };
    var badStatuses = new[] { OrderStatus.Cancelled, OrderStatus.Rejected, OrderStatus.Expired, OrderStatus.DeliveryFailed, OrderStatus.NoShow };
    var isBad = order != null && badStatuses.Contains(order.Status);
    var currentIndex = order == null ? -1 : Array.IndexOf(progressStatuses, order.Status);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Theo dõi đơn hàng</h1>
        <p class="text-muted mb-0">Nhập mã tra cứu (ví dụ QB-7K3M9X) để xem trạng thái đơn.</p>
    </div>
    <a asp-page="/Menu/Index" class="btn btn-outline-primary">Tiếp tục chọn món</a>
</div>

@if (Model.Created)
{
    <div class="alert alert-success">
        Đặt hàng thành công! Mã tra cứu của bạn là <strong>@Model.Code</strong> — hãy lưu lại để theo dõi đơn.
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="card shadow-sm mb-4 track-search-card">
    <div class="card-body p-4">
        <h2 class="h5">Tra cứu bằng mã đơn</h2>
        <form method="post" asp-page-handler="Lookup" class="row g-2">
            <div class="col-sm-8">
                <label asp-for="Code" class="visually-hidden"></label>
                <input asp-for="Code" class="form-control" placeholder="QB-XXXXXX" autocomplete="off" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="col-sm-4 d-grid">
                <button type="submit" class="btn btn-primary">Tra cứu</button>
            </div>
        </form>
    </div>
</div>

@if (Model.Searched && order == null)
{
    <div class="alert alert-warning">Không tìm thấy đơn hàng với mã này. Vui lòng kiểm tra lại mã tra cứu.</div>
}

@if (order != null)
{
    <section data-order-track data-order-code="@order.OrderCode">
        <div class="card shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap justify-content-between gap-3">
                    <div>
                        <span class="text-muted">Đơn hàng của</span>
                        <h2 class="h3 mb-1">@order.CustomerName</h2>
                        <p class="mb-1">Mã tra cứu: <strong>@order.OrderCode</strong></p>
                        <small class="text-muted">Đặt lúc @order.CreatedAt.ToString("dd/MM/yyyy HH:mm") · @order.OrderType.ToDisplayText()</small>
                    </div>
                    <div class="text-md-end">
                        <span class="text-muted">Trạng thái hiện tại</span>
                        <div class="h5 text-primary mb-1">@order.Status.ToDisplayText()</div>
                    </div>
                </div>
            </div>
        </div>

        @if (isBad)
        {
            <div class="alert alert-danger">
                Đơn hàng ở trạng thái <strong>@order.Status.ToDisplayText()</strong>.
            </div>
        }
        else
        {
            <div class="order-progress mb-4" aria-label="Tiến trình đơn hàng">
                @for (var stepIndex = 0; stepIndex < progressStatuses.Length; stepIndex++)
                {
                    var status = progressStatuses[stepIndex];
                    var isCurrent = stepIndex == currentIndex;
                    var isComplete = currentIndex >= 0 && stepIndex < currentIndex;
                    <div class="order-progress-step @(isCurrent ? "is-current" : "") @(isComplete ? "is-complete" : "")"
                         aria-current="@(isCurrent ? "step" : null)">
                        <span class="order-progress-marker">@(stepIndex + 1)</span>
                        <span class="order-progress-label">@status.ToDisplayText()</span>
                    </div>
                }
            </div>
        }

        @if (order.Status == OrderStatus.Pending)
        {
            <form method="post" asp-page-handler="Cancel" class="card shadow-sm mb-4">
                <div class="card-body">
                    <label class="form-label">Lý do hủy đơn</label>
                    <div class="d-flex flex-wrap gap-2">
                        <select name="reason" class="form-select" style="max-width: 320px;" required>
                            <option value="">— Chọn lý do —</option>
                            @foreach (var reason in Model.CancelReasons)
                            {
                                <option value="@reason.Text">@reason.Text</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-outline-danger"
                                onclick="return confirm('Bạn có chắc muốn hủy đơn này?');">
                            Hủy đơn hàng
                        </button>
                    </div>
                </div>
            </form>
        }

        <div class="card shadow-sm">
            <div class="card-header fw-semibold">Chi tiết đơn hàng</div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Món ăn</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in order.Items)
                        {
                            <tr>
                                <td>@(item.MenuItem?.Name ?? $"Món #{item.MenuItemId}")</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@item.UnitPrice.ToString("N0") đ</td>
                                <td class="text-end fw-semibold">@item.LineTotal.ToString("N0") đ</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end">Tiền món</td>
                            <td class="text-end">@order.Subtotal.ToString("N0") đ</td>
                        </tr>
                        @if (order.DeliveryFee > 0)
                        {
                            <tr>
                                <td colspan="3" class="text-end">Phí giao hàng</td>
                                <td class="text-end">@order.DeliveryFee.ToString("N0") đ</td>
                            </tr>
                        }
                        <tr>
                            <th colspan="3" class="text-end">Tổng cộng</th>
                            <th class="text-end text-primary">@order.Total.ToString("N0") đ</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
            @if (order.OrderType == OrderType.Delivery && !string.IsNullOrWhiteSpace(order.Address))
            {
                <div class="card-footer"><strong>Giao tới:</strong> @order.Address</div>
            }
            @if (!string.IsNullOrWhiteSpace(order.Note))
            {
                <div class="card-footer"><strong>Ghi chú:</strong> @order.Note</div>
            }
        </div>
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        (function () {
            var track = document.querySelector('[data-order-track]');
            if (!track || !window.signalR) {
                return;
            }
            var orderCode = track.getAttribute('data-order-code');
            var connection = new signalR.HubConnectionBuilder()
                .withUrl('/orderHub')
                .withAutomaticReconnect()
                .build();
            connection.on('OrderStatusChanged', function () {
                window.location.reload();
            });
            connection.start().then(function () {
                return connection.invoke('WatchOrder', orderCode);
            }).catch(function () { });
        })();
    </script>
}
