@page
@model QuickBite.Pages.Menu.IndexModel

@{
    ViewData["Title"] = "Thực đơn";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Thực đơn</h1>
        <p class="text-muted mb-0">Chọn món yêu thích và thêm vào giỏ hàng.</p>
    </div>
    <a asp-page="/Cart/Index" class="btn btn-outline-primary">Xem giỏ hàng</a>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success" role="alert">@Model.Message</div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

@if (Model.Categories.Count == 0)
{
    <div class="alert alert-info">Hiện chưa có danh mục món ăn.</div>
}

@foreach (var category in Model.Categories)
{
    <section class="mb-5">
        <h2 class="h3 mb-1">@category.Name</h2>
        @if (!string.IsNullOrWhiteSpace(category.Description))
        {
            <p class="text-muted">@category.Description</p>
        }

        @if (category.MenuItems.Count == 0)
        {
            <p class="text-muted">Danh mục này chưa có món ăn.</p>
        }
        else
        {
            <div class="row g-4 mt-1">
                @foreach (var item in category.MenuItems)
                {
                    <div class="col-sm-6 col-lg-4">
                        <article class="card h-100 shadow-sm">
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" class="card-img-top menu-item-image" alt="@item.Name" />
                            }
                            else
                            {
                                <div class="menu-item-placeholder d-flex align-items-center justify-content-center text-muted">
                                    Chưa có hình ảnh
                                </div>
                            }

                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <h3 class="h5 card-title">@item.Name</h3>
                                    @if (!item.IsAvailable)
                                    {
                                        <span class="badge bg-secondary">Hết hàng</span>
                                    }
                                </div>

                                <p class="card-text text-muted flex-grow-1">@item.Description</p>
                                <p class="fs-5 fw-bold text-primary">@item.Price.ToString("N0") đ</p>

                                @if (item.IsAvailable)
                                {
                                    <form method="post" asp-page-handler="AddToCart">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-primary w-100">Thêm vào giỏ</button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-secondary w-100" disabled>Không thể đặt món</button>
                                }
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </section>
}
