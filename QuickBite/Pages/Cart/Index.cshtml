@page
@model QuickBite.Pages.Cart.IndexModel

@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Giỏ hàng</h1>
        <p class="text-muted mb-0">Kiểm tra món ăn và số lượng trước khi đặt hàng.</p>
    </div>
    <a asp-page="/Menu/Index" class="btn btn-outline-primary">Tiếp tục chọn món</a>
</div>

@if (Model.Cart.Count == 0)
{
    <div class="text-center border rounded p-5 bg-light">
        <h2 class="h4">Giỏ hàng đang trống</h2>
        <p class="text-muted">Hãy chọn một món ăn từ thực đơn.</p>
        <a asp-page="/Menu/Index" class="btn btn-primary">Xem thực đơn</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Món ăn</th>
                    <th scope="col" class="text-end">Đơn giá</th>
                    <th scope="col" class="text-center">Số lượng</th>
                    <th scope="col" class="text-end">Thành tiền</th>
                    <th scope="col"><span class="visually-hidden">Thao tác</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Cart)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" class="cart-item-image rounded" alt="@item.Name" />
                                }
                                <strong>@item.Name</strong>
                            </div>
                        </td>
                        <td class="text-end">@item.Price.ToString("N0") đ</td>
                        <td>
                            <div class="d-flex justify-content-center align-items-center gap-2">
                                <form method="post" asp-page-handler="Decrease">
                                    <input type="hidden" name="id" value="@item.MenuItemId" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" aria-label="Giảm số lượng @item.Name">−</button>
                                </form>
                                <span class="fw-semibold cart-quantity">@item.Quantity</span>
                                <form method="post" asp-page-handler="Increase">
                                    <input type="hidden" name="id" value="@item.MenuItemId" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" aria-label="Tăng số lượng @item.Name">+</button>
                                </form>
                            </div>
                        </td>
                        <td class="text-end fw-semibold">@item.Subtotal.ToString("N0") đ</td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="Remove">
                                <input type="hidden" name="id" value="@item.MenuItemId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="row justify-content-end mt-4">
        <div class="col-md-6 col-lg-4">
            <div class="border rounded p-4 bg-light">
                <div class="d-flex justify-content-between mb-2">
                    <span>Tổng số lượng</span>
                    <strong>@Model.TotalQuantity</strong>
                </div>
                <div class="d-flex justify-content-between fs-4">
                    <span>Tổng tiền</span>
                    <strong class="text-primary">@Model.Total.ToString("N0") đ</strong>
                </div>
            </div>

            <a asp-page="/Checkout/Index" class="btn btn-primary btn-lg w-100 mt-3">
                Tiến hành thanh toán
            </a>

            <form method="post" asp-page-handler="Clear" class="mt-3 text-end">
                <button type="submit" class="btn btn-outline-danger">Xóa toàn bộ giỏ hàng</button>
            </form>
        </div>
    </div>
}
