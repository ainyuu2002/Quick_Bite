@using QuickBite.Models
@{
    var path = Context.Request.Path;
    bool isMenuItems = path.StartsWithSegments("/Admin/MenuItems");
    bool isOrders = path.StartsWithSegments("/Admin/Orders");
    bool isStaff = path.StartsWithSegments("/Admin/Staff");
    bool isReports = path.StartsWithSegments("/Admin/Reports");
    bool isKitchen = path.StartsWithSegments("/Admin/Kitchen");
    bool isShipper = path.StartsWithSegments("/Admin/Shipper");
    bool isBlacklist = path.StartsWithSegments("/Admin/Blacklist");

    // Ẩn mục theo vai không phải là bảo mật — chặn thật nằm ở policy trong Program.cs.
    // Ẩn ở đây chỉ để mỗi vai khỏi bấm vào trang ngoài quyền rồi ăn trang từ chối.
    bool isOwner = User.IsInRole(nameof(AccountRole.Admin)) || User.IsInRole(nameof(AccountRole.Manager));
    bool canStaff = isOwner || User.IsInRole(nameof(AccountRole.Staff));
    bool canKitchen = isOwner || User.IsInRole(nameof(AccountRole.Kitchen));
    bool canShipper = isOwner || User.IsInRole(nameof(AccountRole.Shipper));
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuickBite Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-app">
    <div class="admin-shell">
        <aside class="admin-rail">
            <a class="admin-rail__brand" asp-page="/Admin/Orders/Index">
                <span class="admin-rail__mark" aria-hidden="true">QB</span>
                <span>
                    <span class="admin-rail__name">QuickBite</span>
                    <span class="admin-rail__meta">Quản trị quán</span>
                </span>
            </a>

            <nav class="admin-rail__nav" aria-label="Điều hướng quản trị">
                @if (canStaff)
                {
                    <a class="admin-rail__link" asp-page="/Admin/Orders/Index" aria-current="@(isOrders ? "page" : null)">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 2.5h10v11H3zM5 5h6M5 8h6M5 11h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
                        Đơn hàng
                    </a>
                }
                @if (canKitchen)
                {
                    <a class="admin-rail__link" asp-page="/Admin/Kitchen/Index" aria-current="@(isKitchen ? "page" : null)">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 2.5v4M6 2.5v4M5 6.5v7M9.5 2.5c-1 1.5-1 3.5 0 5v6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        Bếp
                    </a>
                }
                @if (canShipper)
                {
                    <a class="admin-rail__link" asp-page="/Admin/Shipper/Index" aria-current="@(isShipper ? "page" : null)">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M1.5 4.5h7v6h-7zM8.5 6.5h3l2 2v2h-5zM4 12.5a1 1 0 1 0 0-2 1 1 0 0 0 0 2ZM11 12.5a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        Shipper
                    </a>
                }
                @if (isOwner)
                {
                    <a class="admin-rail__link" asp-page="/Admin/MenuItems/Index" aria-current="@(isMenuItems ? "page" : null)">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 11h11M4 11a4 4 0 0 1 8 0M8 4.5V6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        Món ăn
                    </a>
                    <a class="admin-rail__link" asp-page="/Admin/Staff/Index" aria-current="@(isStaff ? "page" : null)">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM3 13.5a5 5 0 0 1 10 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        Nhân viên
                    </a>
                    @* Doanh thu là thông tin nhạy cảm — chỉ chủ quán xem. Ẩn link ở đây,
                       chặn thật bằng policy "AdminOnly" trên /Admin/Reports trong Program.cs. *@
                    <a class="admin-rail__link" asp-page="/Admin/Reports/Revenue" aria-current="@(isReports ? "page" : null)">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 13.5h11M4 13.5V9m4 4.5V5.5m4 8V3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
                        Doanh thu
                    </a>
                    <a class="admin-rail__link" asp-page="/Admin/Blacklist/Index" aria-current="@(isBlacklist ? "page" : null)">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 1.5 2.5 4v3.5c0 3.2 2.3 5.6 5.5 7 3.2-1.4 5.5-3.8 5.5-7V4L8 1.5ZM6 8l4-4M10 8 6 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        SĐT cảnh báo
                    </a>
                }
            </nav>

            <div class="admin-rail__foot">
                <form method="post" asp-page="/Admin/Login" asp-page-handler="Logout">
                    <button type="submit" class="btn btn--rail">Đăng xuất</button>
                </form>
            </div>
        </aside>

        <main class="admin-main" id="main-content">
            <div class="admin-content">@RenderBody()</div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
