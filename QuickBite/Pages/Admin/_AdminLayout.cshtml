@using QuickBite.Models
@using QuickBite.Modules.Operations.Authorization
@{
    var path = Context.Request.Path;
    bool isMenuItems = path.StartsWithSegments("/Admin/MenuItems");
    bool isOrders = path.StartsWithSegments("/Admin/Orders");
    bool isStaff = path.StartsWithSegments("/Admin/Staff");
    bool isReports = path.StartsWithSegments("/Admin/Reports");
    bool isStoreOperations = path.Equals("/Admin/Operations/Store");
    bool isMenuAvailability = path.Equals("/Admin/Operations/MenuAvailability");
    bool isPromotions = path.StartsWithSegments("/Admin/Promotions");
    bool isComplaints = path.StartsWithSegments("/Admin/Complaints");

    // Ẩn mục chỉ dành cho chủ quán không phải là bảo mật — chặn thật nằm ở policy
    // ManagerOnly trong Program.cs. Ẩn ở đây chỉ để nhân viên khỏi bấm vào rồi ăn trang từ chối.
    bool isManager = User.IsInRole(InternalRoles.Manager);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuickBite Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-app">
    <div class="admin-shell">
        <aside class="admin-rail">
            <a class="admin-rail__brand" asp-page="/Admin/Orders/Index">
                <span class="admin-rail__mark" aria-hidden="true">QB</span>
                <span>
                    <span class="admin-rail__name">QuickBite</span>
                    <span class="admin-rail__meta">Quản trị quán</span>
                </span>
            </a>

            <nav class="admin-rail__nav" aria-label="Điều hướng quản trị">
                <a class="admin-rail__link" asp-page="/Admin/Orders/Index" aria-current="@(isOrders ? "page" : null)">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 2.5h10v11H3zM5 5h6M5 8h6M5 11h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
                    Đơn hàng
                </a>
                <a class="admin-rail__link" asp-page="/Admin/Operations/Store" aria-current="@(isStoreOperations ? "page" : null)">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 6.5h11M3.5 6.5v7h9v-7M2 6.5l1.5-4h9l1.5 4M6 13.5v-4h4v4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    Cửa hàng
                </a>
                <a class="admin-rail__link" asp-page="/Admin/Complaints/Index" aria-current="@(isComplaints ? "page" : null)">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 3.5h11v7h-6l-3 3v-3h-2zM5 6h6M5 8.5h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    Phản ánh
                </a>
                @if (isManager)
                {
                    <a class="admin-rail__link" asp-page="/Admin/Operations/MenuAvailability" aria-current="@(isMenuAvailability ? "page" : null)">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 3.5h10M3 7.8h10M3 12h10M5 2v3M10 6.3v3M7 10.5v3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
                        Quota món
                    </a>
                    <a class="admin-rail__link" asp-page="/Admin/MenuItems/Index" aria-current="@(isMenuItems ? "page" : null)">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 11h11M4 11a4 4 0 0 1 8 0M8 4.5V6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        Món ăn
                    </a>
                    <a class="admin-rail__link" asp-page="/Admin/Promotions/Index" aria-current="@(isPromotions ? "page" : null)">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 2.5 9.5 6l3.8.3-2.9 2.5.9 3.7L8 10.5l-3.3 2 .9-3.7-2.9-2.5L6.5 6z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
                        Khuyến mãi
                    </a>
                    <a class="admin-rail__link" asp-page="/Admin/Staff/Index" aria-current="@(isStaff ? "page" : null)">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM3 13.5a5 5 0 0 1 10 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        Nhân viên
                    </a>
                    @* Doanh thu là thông tin nhạy cảm — chỉ chủ quán xem. Ẩn link ở đây,
                       chặn thật bằng policy ManagerOnly trên /Admin/Reports trong Program.cs. *@
                    <a class="admin-rail__link" asp-page="/Admin/Reports/Revenue" aria-current="@(isReports ? "page" : null)">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 13.5h11M4 13.5V9m4 4.5V5.5m4 8V3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
                        Doanh thu
                    </a>
                }
            </nav>

            <div class="admin-rail__foot">
                <form method="post" asp-page="/Admin/Login" asp-page-handler="Logout">
                    <button type="submit" class="btn btn--rail">Đăng xuất</button>
                </form>
            </div>
        </aside>

        <main class="admin-main" id="main-content">
            <div class="admin-content">@RenderBody()</div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
