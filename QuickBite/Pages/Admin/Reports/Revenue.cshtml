@page
@model QuickBite.Pages.Admin.Reports.RevenueModel
@using QuickBite.Models

@{
    ViewData["Title"] = "Doanh thu";

    var today = DateTime.Today;
    var monthStart = new DateTime(today.Year, today.Month, 1);
    var yearStart = new DateTime(today.Year, 1, 1);

    string D(DateTime d) => d.ToString("yyyy-MM-dd");
}

<style>
    .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-md); margin-bottom: var(--space-md); }
    .stat-card { padding: var(--space-lg); background: var(--color-surface); border: 1px solid var(--color-rule); border-radius: var(--radius-surface); box-shadow: var(--shadow-surface); }
    .stat-card__label { color: var(--color-ink-2); font-size: var(--text-sm); }
    .stat-card__value { margin-top: var(--space-xs); color: var(--color-ink); font: 700 var(--text-title)/1.2 var(--font-display); font-variant-numeric: tabular-nums; }
    .revenue-toolbar { align-items: flex-end; }
    .revenue-toolbar .field { flex: 0 1 12rem; }
    .revenue-quick { display: flex; gap: var(--space-xs); margin-left: auto; }
    .revenue-section-title { margin: var(--space-lg) 0 var(--space-sm); color: var(--color-ink); font: 600 var(--text-md)/1.2 var(--font-display); }
    .share-bar { position: relative; min-width: 140px; height: 8px; border-radius: var(--radius-round); background: var(--color-paper-2); overflow: hidden; }
    .share-bar__fill { position: absolute; inset: 0 auto 0 0; border-radius: inherit; background: var(--color-accent); }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Doanh thu</h1>
        <p class="page-description">Tổng hợp các đơn hoàn tất.</p>
    </div>
</div>

<form method="get" class="toolbar revenue-toolbar">
    <div class="field">
        <label class="label" asp-for="From">Từ ngày</label>
        <input type="date" asp-for="From" class="input" />
    </div>
    <div class="field">
        <label class="label" asp-for="To">Đến ngày</label>
        <input type="date" asp-for="To" class="input" />
    </div>
    <button type="submit" class="btn btn--primary btn--sm">Xem</button>
    <div class="revenue-quick">
        <a class="btn btn--secondary btn--sm" asp-page="./Revenue" asp-route-From="@D(today)" asp-route-To="@D(today)">Hôm nay</a>
        <a class="btn btn--secondary btn--sm" asp-page="./Revenue" asp-route-From="@D(monthStart)" asp-route-To="@D(today)">Tháng này</a>
        <a class="btn btn--secondary btn--sm" asp-page="./Revenue" asp-route-From="@D(yearStart)" asp-route-To="@D(today)">Năm nay</a>
    </div>
</form>

<p class="result-summary" role="status">
    Từ @Model.From!.Value.ToString("dd/MM/yyyy") đến @Model.To!.Value.ToString("dd/MM/yyyy"):
    @Model.Orders.Count đơn hoàn tất.
</p>

<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-card__label">Tổng doanh thu</div>
        <div class="stat-card__value">@Model.TotalRevenue.ToString("N0") đ</div>
    </div>
    <div class="stat-card">
        <div class="stat-card__label">Số đơn hoàn tất</div>
        <div class="stat-card__value">@Model.Orders.Count</div>
    </div>
    <div class="stat-card">
        <div class="stat-card__label">Trung bình / đơn</div>
        <div class="stat-card__value">
            @((Model.Orders.Count > 0 ? Model.TotalRevenue / Model.Orders.Count : 0).ToString("N0")) đ
        </div>
    </div>
</div>

@if (Model.ByItem.Any())
{
    var totalQuantity = Model.ByItem.Sum(x => x.Quantity);

    <h2 class="revenue-section-title">Món bán chạy</h2>
    <div class="data-surface">
        <table class="table">
            <thead>
                <tr>
                    <th>Món</th>
                    <th class="num">Số suất</th>
                    <th class="num">Doanh thu</th>
                    <th>Tỷ lệ suất ăn đã bán</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ByItem)
                {
                    var percent = totalQuantity > 0 ? item.Quantity * 100.0 / totalQuantity : 0;

                    <tr>
                        <td>@item.Name</td>
                        <td class="num">@item.Quantity</td>
                        <td class="num">@item.Total.ToString("N0") đ</td>
                        <td>
                            <div class="share-bar" role="img" aria-label="@percent.ToString("0.#")% số suất">
                                <span class="share-bar__fill" style="width: @percent.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.ByDay.Count > 1)
{
    <h2 class="revenue-section-title">Doanh thu theo ngày</h2>
    <div class="data-surface">
        <table class="table">
            <thead>
                <tr>
                    <th>Ngày</th>
                    <th class="num">Số đơn</th>
                    <th class="num">Doanh thu</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var day in Model.ByDay)
                {
                    <tr>
                        <td>@day.Day.ToString("dd/MM/yyyy")</td>
                        <td class="num">@day.Count</td>
                        <td class="num">@day.Total.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="revenue-section-title">Danh sách thanh toán thành công</h2>
<div class="data-surface">
    @if (Model.Orders.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>SĐT</th>
                    <th>Thanh toán</th>
                    <th>Thời gian đặt</th>
                    <th class="num">Tổng tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td><span class="order-id">#@order.Id</span></td>
                        <td>@order.CustomerName</td>
                        <td>@order.Phone</td>
                        <td>
                            <span class="badge @(order.PaymentMethod == PaymentMethod.BankTransfer ? "badge--success" : "badge--muted")">
                                @order.PaymentMethod.ToDisplayText()
                            </span>
                        </td>
                        <td>
                            <time datetime="@order.CreatedAt.ToString("O")">
                                @order.CreatedAt.ToString("HH:mm dd/MM/yyyy")
                            </time>
                        </td>
                        <td class="num">@order.Total.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="empty-state">Không có đơn hoàn tất nào trong khoảng ngày này.</p>
    }
</div>
