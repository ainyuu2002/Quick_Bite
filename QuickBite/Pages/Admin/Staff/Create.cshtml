@page
@model QuickBite.Pages.Admin.Staff.CreateModel
@using QuickBite.Models

@{
    ViewData["Title"] = "Thêm nhân viên";
}

<div class="page-header">
    <h1 class="page-title">Thêm nhân viên</h1>
</div>

<div class="form-surface">
    <form method="post">
        <div class="form-grid">
            <div asp-validation-summary="ModelOnly" class="form-error field--wide"></div>

            <div class="field">
                <label asp-for="Input.Username" class="label">Tên đăng nhập</label>
                <input asp-for="Input.Username" class="input" autocomplete="off" />
                <p class="field-hint">Chỉ chữ, số, dấu chấm và gạch dưới.</p>
                <span asp-validation-for="Input.Username" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Input.FullName" class="label">Họ tên</label>
                <input asp-for="Input.FullName" class="input" />
                <p class="field-hint">Tên này hiện ở cột "Người nhận" của đơn hàng.</p>
                <span asp-validation-for="Input.FullName" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Input.Password" class="label">Mật khẩu</label>
                <input asp-for="Input.Password" class="input" autocomplete="new-password" />
                <p class="field-hint">Tối thiểu 6 ký tự.</p>
                <span asp-validation-for="Input.Password" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Input.ConfirmPassword" class="label">Nhập lại mật khẩu</label>
                <input asp-for="Input.ConfirmPassword" class="input" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
            </div>

            <div class="field field--wide">
                <label asp-for="Input.Role" class="label">Vai trò</label>
                @* Không dùng Html.GetEnumSelectList: nó hiện tên enum tiếng Anh (Admin/Staff).
                   Liệt kê tay để dùng ToDisplayText() — cùng nguồn chữ với chỗ khác trong app. *@
                <select asp-for="Input.Role" class="select">
                    @foreach (var role in Enum.GetValues<AccountRole>())
                    {
                        <option value="@((int)role)">@role.ToDisplayText()</option>
                    }
                </select>
                <p class="field-hint">
                    Nhân viên: chỉ xử lý đơn hàng. Chủ quán: thêm quyền quản lý món ăn và tài khoản.
                </p>
                <span asp-validation-for="Input.Role" class="field-error"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn--primary">Tạo tài khoản</button>
                <a asp-page="./Index" class="btn btn--secondary">Hủy</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
