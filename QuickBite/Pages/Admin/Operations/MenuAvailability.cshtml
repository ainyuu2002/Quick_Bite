@page
@model QuickBite.Pages.Admin.Operations.MenuAvailabilityModel

@{
    ViewData["Title"] = "Quota món";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Quota và khung giờ bán</h1>
        <p class="page-description">
            Quota tự reset khi sang ngày mới. Để trống cả hai ô giờ nếu món được bán cả ngày.
        </p>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert--success" role="status">@successMessage</div>
}

<div asp-validation-summary="All" class="alert alert--danger"></div>

<div class="data-surface">
    <table class="table">
        <thead>
            <tr>
                <th>Món</th>
                <th class="num">Đã giữ</th>
                <th class="num">Còn lại</th>
                <th>Trạng thái</th>
                <th>Cấu hình</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td><span class="menu-cell__name">@item.MenuItemName</span></td>
                    <td class="num">@item.ReservedQuantity</td>
                    <td class="num">@item.RemainingQuantity</td>
                    <td>
                        @if (item.IsAvailable)
                        {
                            <span class="badge badge--success">Đang bán</span>
                        }
                        else
                        {
                            <span class="badge badge--muted">Tạm hết</span>
                        }
                    </td>
                    <td>
                        <form method="post" asp-page-handler="Save" class="quota-form">
                            <input type="hidden" name="Input.MenuItemId" value="@item.MenuItemId" />
                            <label>
                                <span class="visually-hidden">Quota của @item.MenuItemName</span>
                                <input type="number" name="Input.DailyLimit" value="@item.DailyLimit"
                                       min="1" max="10000" class="input quota-form__limit" />
                            </label>
                            <label>
                                <span class="visually-hidden">Bắt đầu bán @item.MenuItemName</span>
                                <input type="time" name="Input.SaleStartsAt"
                                       value="@item.SaleStartsAt?.ToString("HH:mm")" class="input quota-form__time" />
                            </label>
                            <span aria-hidden="true">–</span>
                            <label>
                                <span class="visually-hidden">Kết thúc bán @item.MenuItemName</span>
                                <input type="time" name="Input.SaleEndsAt"
                                       value="@item.SaleEndsAt?.ToString("HH:mm")" class="input quota-form__time" />
                            </label>
                            <button type="submit" class="btn btn--secondary btn--sm">Lưu</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
