@page
@model QuickBite.Pages.Admin.Orders.IndexModel
@using QuickBite.Models

@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="page-header">
    <h1 class="page-title">Quản lý đơn hàng</h1>
</div>

<nav class="tabs" aria-label="Lọc theo trạng thái">
    @foreach (var status in Enum.GetValues<OrderStatus>())
    {
        <a class="tab" asp-route-status="@status" aria-current="@(status == Model.CurrentStatus ? "page" : null)">
            @status.ToDisplayText()
        </a>
    }
</nav>

<div class="table-wrap">
    <table class="table">
        <thead>
            <tr>
                <th>Mã đơn</th>
                <th>Khách hàng</th>
                <th>SĐT</th>
                <th class="num">Tổng tiền</th>
                <th>Thời gian đặt</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model.Orders)
            {
                <tr>
                    <td>#@order.Id</td>
                    <td>@order.CustomerName</td>
                    <td>@order.Phone</td>
                    <td class="num">@order.Total.ToString("N0") đ</td>
                    <td>@order.CreatedAt.ToString("HH:mm dd/MM/yyyy")</td>
                    <td></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Orders.Any())
{
    <p class="empty-state">Không có đơn nào ở trạng thái này.</p>
}