@page
@model QuickBite.Pages.Admin.Orders.IndexModel
@using QuickBite.Models

@{
    ViewData["Title"] = "Quản lý đơn hàng";

    string SortLink(string column)
    {
        var nextDir = (Model.SortBy == column && Model.SortDir == "asc") ? "desc" : "asc";
        return Url.Page("./Index", new
        {
            status = Model.CurrentStatus,
            search = Model.Search,
            sortBy = column,
            sortDir = nextDir,
            pageNumber = 1
        })!;
    }

    string SortArrow(string column)
        => Model.SortBy != column ? "" : (Model.SortDir == "asc" ? " ▲" : " ▼");

    string? AriaSort(string column)
        => Model.SortBy != column ? null : (Model.SortDir == "asc" ? "ascending" : "descending");
}

<div class="page-header">
    <div>
        <h1 class="page-title">Quản lý đơn hàng</h1>
        <p class="page-description">Theo dõi và xử lý đơn theo từng trạng thái.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert--success" role="status">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert--danger" role="alert">@errorMessage</div>
}

<nav class="tabs" aria-label="Lọc theo trạng thái">
    @foreach (var status in Enum.GetValues<OrderStatus>())
    {
        <a class="tab"
           asp-route-status="@status"
           asp-route-search="@Model.Search"
           asp-route-sortBy="@Model.SortBy"
           asp-route-sortDir="@Model.SortDir"
           asp-route-pageNumber="1"
           aria-current="@(status == Model.CurrentStatus ? "page" : null)">
            @status.ToDisplayText()
        </a>
    }
</nav>

<form method="get" asp-page="./Index" class="toolbar">
    <input type="hidden" name="status" value="@Model.CurrentStatus" />
    <input type="hidden" name="sortBy" value="@Model.SortBy" />
    <input type="hidden" name="sortDir" value="@Model.SortDir" />
    <input type="text"
           name="search"
           value="@Model.Search"
           placeholder="Tìm theo mã đơn, tên khách hoặc SĐT…"
           aria-label="Tìm đơn hàng"
           class="input" />
    <button type="submit" class="btn btn--secondary btn--sm">Tìm</button>
</form>

<p class="result-summary" role="status">
    @* id riêng để JS cập nhật được con số sau khi làm mới bảng, mà không xoá mất chỉ báo kết nối *@
    <span id="resultCount">Tìm thấy @Model.Result.TotalCount đơn hàng trong trạng thái @Model.CurrentStatus.ToDisplayText().</span>
    <span class="live-dot" id="liveDot" title="Đang kết nối thời gian thực" hidden></span>
    <span class="live-label" id="liveLabel" hidden>Trực tuyến</span>
    <span class="badge badge--muted">
        <span id="staffOnline">@Model.StaffOnline</span> nhân viên đang trực
    </span>
</p>

@* FR-17: băng thông báo khi có đơn mới / đơn đổi trạng thái ngoài phạm vi trang đang xem *@
<div class="alert alert--info live-banner" id="liveBanner" role="status" hidden>
    <span id="liveBannerText"></span>
    <a class="btn btn--secondary btn--sm" href="javascript:location.reload()">Tải lại</a>
</div>

@* Bảng luôn được render, kể cả khi rỗng: SignalR cần sẵn <tbody> để chèn đơn mới vào.
   Trạng thái rỗng là một hàng trong bảng, JS sẽ gỡ nó khi có đơn đầu tiên tới. *@
<div class="data-surface">
    <table class="table">
        <thead>
            <tr>
                <th>Mã đơn</th>
                <th>Khách hàng</th>
                <th>SĐT</th>
                <th class="num" aria-sort="@AriaSort("total")">
                    <a href="@SortLink("total")">Tổng tiền<span aria-hidden="true">@SortArrow("total")</span></a>
                </th>
                <th aria-sort="@AriaSort("date")">
                    <a href="@SortLink("date")">Thời gian đặt<span aria-hidden="true">@SortArrow("date")</span></a>
                </th>
                <th>Trạng thái</th>
                <th>Người nhận</th>
            </tr>
        </thead>
        <tbody id="ordersTableBody" data-current-status="@((int)Model.CurrentStatus)">
            @if (!Model.Result.Items.Any())
            {
                <tr id="emptyRow">
                    <td colspan="7"><p class="empty-state">Không có đơn nào khớp điều kiện.</p></td>
                </tr>
            }
            @foreach (var order in Model.Result.Items)
            {
                <tr data-order-id="@order.Id">
                    <td><span class="order-id">@order.OrderCode</span></td>
                    <td>@order.CustomerName</td>
                    <td>
                        @order.Phone
                        @if (Model.BlacklistedPhones.Contains(order.Phone))
                        {
                            <span class="badge badge--danger" title="Số điện thoại trong danh sách cảnh báo bùng hàng">⚠ SĐT cảnh báo</span>
                        }
                    </td>
                    <td class="num">@order.Total.ToString("N0") đ</td>
                    <td>
                        <time datetime="@order.CreatedAt.ToString("O")">
                            @order.CreatedAt.ToString("HH:mm dd/MM/yyyy")
                        </time>
                    </td>
                    <td class="order-status-cell"><span class="badge badge--muted">@order.Status.ToDisplayText()</span></td>
                    <td>
                        @if (order.AcceptedByAccount is not null)
                        {
                            <div>@(order.AcceptedByAccount.FullName ?? order.AcceptedByAccount.Username)</div>
                            @if (order.AcceptedAt is DateTime acceptedAt)
                            {
                                <time class="accepted-at" datetime="@acceptedAt.ToString("O")">
                                    lúc @acceptedAt.ToString("HH:mm dd/MM")
                                </time>
                            }
                        }
                        else
                        {
                            <span class="muted">Chưa ai nhận</span>
                        }
                    </td>
                </tr>
                <tr class="order-details-row" data-details-for="@order.Id">
                    <td colspan="7">
                        <details class="order-details">
                            <summary>Xem chi tiết và xử lý</summary>
                            <div class="order-details__content">
                                <dl class="order-meta">
                                    <div>
                                        <dt>Hình thức</dt>
                                        <dd>@order.OrderType.ToDisplayText()</dd>
                                    </div>
                                    <div>
                                        <dt>Địa chỉ giao hàng</dt>
                                        <dd>@(order.OrderType == OrderType.Pickup ? "Nhận tại quán" : (order.Address ?? "—"))</dd>
                                    </div>
                                    <div>
                                        <dt>Phương thức thanh toán</dt>
                                        <dd>@order.PaymentMethod.ToDisplayText()</dd>
                                    </div>
                                    @if (Model.StatusReasons.TryGetValue(order.Id, out var statusReason))
                                    {
                                        <div>
                                            <dt>Lý do (hủy/từ chối/thất bại)</dt>
                                            <dd>@statusReason</dd>
                                        </div>
                                    }
                                    <div>
                                        <dt>Trạng thái thanh toán</dt>
                                        <dd>
                                            <span class="badge @(order.PaymentStatus == PaymentStatus.Paid ? "badge--muted" : "badge--danger")">
                                                @order.PaymentStatus.ToDisplayText()
                                            </span>
                                            @if (order.PaymentStatus == PaymentStatus.Unpaid
                                                && order.PaymentMethod == PaymentMethod.Cash)
                                            {
                                                <span class="muted">Tiền mặt — tự xác nhận khi đơn hoàn tất</span>
                                            }
                                        </dd>
                                    </div>
                                    <div>
                                        <dt>Ghi chú</dt>
                                        <dd>@(string.IsNullOrWhiteSpace(order.Note) ? "Không có" : order.Note)</dd>
                                    </div>
                                </dl>

                                <div class="order-items-wrap">
                                    <table class="order-items-table">
                                        <thead>
                                            <tr>
                                                <th>Món</th>
                                                <th class="num">Số lượng</th>
                                                <th class="num">Đơn giá</th>
                                                <th class="num">Thành tiền</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in order.Items)
                                            {
                                                <tr>
                                                    <td>@(item.MenuItem?.Name ?? $"Món #{item.MenuItemId}")</td>
                                                    <td class="num">@item.Quantity</td>
                                                    <td class="num">@item.UnitPrice.ToString("N0") đ</td>
                                                    <td class="num">@item.LineTotal.ToString("N0") đ</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td colspan="3" class="num">Tiền món</td>
                                                <td class="num">@order.Subtotal.ToString("N0") đ</td>
                                            </tr>
                                            @if (order.DeliveryFee > 0)
                                            {
                                                <tr>
                                                    <td colspan="3" class="num">Phí giao</td>
                                                    <td class="num">@order.DeliveryFee.ToString("N0") đ</td>
                                                </tr>
                                            }
                                            <tr>
                                                <th colspan="3">Tổng cộng</th>
                                                <th class="num">@order.Total.ToString("N0") đ</th>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>

                                @if (order.Status == OrderStatus.Pending)
                                {
                                    <details class="contact-edit">
                                        <summary>Sửa thông tin liên hệ</summary>
                                        <form method="post" asp-page-handler="UpdateContact" class="contact-edit__form">
                                            <input type="hidden" name="orderId" value="@order.Id" />
                                            <input type="hidden" name="currentStatus" value="@Model.CurrentStatus" />
                                            <input type="hidden" name="search" value="@Model.Search" />
                                            <input type="hidden" name="sortBy" value="@Model.SortBy" />
                                            <input type="hidden" name="sortDir" value="@Model.SortDir" />
                                            <input type="hidden" name="pageNumber" value="@Model.Result.Page" />
                                            <label>Tên khách
                                                <input class="input" name="customerName" value="@order.CustomerName" required />
                                            </label>
                                            <label>Số điện thoại
                                                <input class="input" name="phone" value="@order.Phone" required />
                                            </label>
                                            @if (order.OrderType == OrderType.Delivery)
                                            {
                                                <label>Địa chỉ
                                                    <input class="input" name="address" value="@order.Address" required />
                                                </label>
                                            }
                                            <button class="btn btn--secondary btn--sm" type="submit">Lưu liên hệ</button>
                                        </form>
                                    </details>
                                }

                                <div class="order-actions">
                                    @{
                                        var nextStatuses = QuickBite.Pages.Admin.Orders.IndexModel.AdminNextStatuses(order.Status, order.OrderType);
                                    }
                                    @if (order.Status.IsTerminal())
                                    {
                                        <span class="badge badge--muted">Đơn đã kết thúc</span>
                                    }
                                    @foreach (var next in nextStatuses)
                                    {
                                        var needsReason = next.RequiresReason();
                                        <form method="post" asp-page-handler="ChangeStatus" class="order-action-form">
                                            <input type="hidden" name="orderId" value="@order.Id" />
                                            <input type="hidden" name="nextStatus" value="@next" />
                                            <input type="hidden" name="currentStatus" value="@Model.CurrentStatus" />
                                            <input type="hidden" name="search" value="@Model.Search" />
                                            <input type="hidden" name="sortBy" value="@Model.SortBy" />
                                            <input type="hidden" name="sortDir" value="@Model.SortDir" />
                                            <input type="hidden" name="pageNumber" value="@Model.Result.Page" />
                                            @if (needsReason)
                                            {
                                                <span class="reason-group" data-reason-group>
                                                    <select name="reason" class="input" required aria-label="Lý do @next.ToDisplayText()" data-reason-select>
                                                        <option value="">— Chọn lý do —</option>
                                                        @foreach (var reasonOption in Model.ReasonsFor(next))
                                                        {
                                                            <option value="@reasonOption.Text">@reasonOption.Text</option>
                                                        }
                                                        <option value="__other__">Khác…</option>
                                                    </select>
                                                    <input type="text" name="reasonOther" class="input" placeholder="Nhập lý do" data-reason-other hidden />
                                                </span>
                                            }
                                            <button class="btn @(needsReason ? "btn--danger-quiet" : "btn--primary") btn--sm" type="submit">
                                                @next.ToDisplayText()
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </details>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Result.TotalPages > 1)
{
    <nav class="pagination" aria-label="Phân trang">
        @if (Model.Result.HasPrevious)
        {
            <a class="btn btn--secondary btn--sm"
               asp-page="./Index"
               asp-route-status="@Model.CurrentStatus"
               asp-route-search="@Model.Search"
               asp-route-sortBy="@Model.SortBy"
               asp-route-sortDir="@Model.SortDir"
               asp-route-pageNumber="@(Model.Result.Page - 1)">« Trước</a>
        }

        <span>Trang @Model.Result.Page / @Model.Result.TotalPages</span>

        @if (Model.Result.HasNext)
        {
            <a class="btn btn--secondary btn--sm"
               asp-page="./Index"
               asp-route-status="@Model.CurrentStatus"
               asp-route-search="@Model.Search"
               asp-route-sortBy="@Model.SortBy"
               asp-route-sortDir="@Model.SortDir"
               asp-route-pageNumber="@(Model.Result.Page + 1)">Sau »</a>
        }
    </nav>
}

@section Scripts {
    <script src="~/js/reason-other.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/admin-orders.js" asp-append-version="true"></script>
}
