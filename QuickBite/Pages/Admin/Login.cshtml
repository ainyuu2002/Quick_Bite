@page
@model QuickBite.Pages.Admin.LoginModel
@{
    ViewData["Title"] = "Đăng nhập Admin";
    Layout = "_AdminAuthLayout";
}

<section class="auth-brand" aria-label="QuickBite Admin">
    <div class="auth-brand__mark" aria-hidden="true">QB</div>
    <p class="auth-brand__name">QuickBite</p>
    <h1 class="auth-brand__title">Vận hành quán, rõ ràng trong từng đơn.</h1>
    <p class="auth-brand__copy">Khu vực quản trị dành cho chủ quán và nhân viên.</p>
</section>
<section class="auth-panel" aria-labelledby="login-title">
    <div class="auth-panel__inner">
        <p class="auth-eyebrow">QUICKBITE ADMIN</p>
        <h2 class="auth-title" id="login-title">Chào mừng trở lại</h2>
        <p class="auth-subtitle">Đăng nhập để tiếp tục quản lý đơn hàng và thực đơn.</p>
        <form method="post" class="auth-form" id="loginForm">
            <div asp-validation-summary="ModelOnly" class="auth-error" role="alert"></div>
            <div class="auth-field">
                <label asp-for="Username" class="auth-label">Tên đăng nhập</label>
                <input asp-for="Username" class="auth-input" autocomplete="username" autofocus />
                <span asp-validation-for="Username" class="auth-field-error"></span>
            </div>
            <div class="auth-field">
                <label asp-for="Password" class="auth-label">Mật khẩu</label>
                <input asp-for="Password" type="password" class="auth-input" autocomplete="current-password" />
                <span asp-validation-for="Password" class="auth-field-error"></span>
            </div>
            <button type="submit" class="auth-btn" id="loginBtn"><span class="auth-btn__label">Đăng nhập</span></button>
        </form>
    </div>
</section>

@section Scripts {
    <script>
        document.getElementById('loginForm').addEventListener('submit', function (e) {
            var form = e.currentTarget;
            var btn = document.getElementById('loginBtn');
            var label = btn.querySelector('.auth-btn__label');
            btn.classList.add('is-loading');
            label.textContent = 'Đang đăng nhập…';
            setTimeout(function () {
                btn.disabled = true;
                form.querySelectorAll('.auth-input').forEach(function (el) { el.disabled = true; });
            }, 0);
        });
    </script>
}
