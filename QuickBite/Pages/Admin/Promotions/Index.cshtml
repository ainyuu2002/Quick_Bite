@page
@model QuickBite.Pages.Admin.Promotions.IndexModel
@using QuickBite.Models

@{
    ViewData["Title"] = "Mã khuyến mãi";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Mã khuyến mãi</h1>
        <p class="page-description">Tạo và quản lý các mã giảm giá cho khách hàng.</p>
    </div>
    <a asp-page="Create" class="btn btn--primary">Tạo mã mới</a>
</div>

<div class="data-surface">
    @if (Model.Promotions.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Ưu đãi</th>
                    <th>Điều kiện</th>
                    <th>Hiệu lực</th>
                    <th class="num">Đã dùng</th>
                    <th>Trạng thái</th>
                    <th><span class="visually-hidden">Thao tác</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Promotions)
                {
                    var promotion = row.Promotion;
                    var now = DateTime.Now;
                    var inWindow = now >= promotion.StartsAt && now <= promotion.EndsAt;
                    <tr>
                        <td>
                            <strong>@promotion.Code</strong>
                            @if (!string.IsNullOrWhiteSpace(promotion.Description))
                            {
                                <br /><small>@promotion.Description</small>
                            }
                        </td>
                        <td>
                            @if (promotion.DiscountType == DiscountType.Percent)
                            {
                                <span>Giảm @promotion.DiscountValue.ToString("N0")%</span>
                                @if (promotion.MaxDiscountAmount is not null)
                                {
                                    <br /><small>tối đa @promotion.MaxDiscountAmount.Value.ToString("N0") đ</small>
                                }
                            }
                            else
                            {
                                <span>Giảm @promotion.DiscountValue.ToString("N0") đ</span>
                            }
                        </td>
                        <td>
                            Đơn từ @promotion.MinOrderTotal.ToString("N0") đ
                            <br /><small>@promotion.PerPhoneLimit lượt/SĐT@(promotion.TotalUsageLimit is not null ? $" · tổng {promotion.TotalUsageLimit} lượt" : "")</small>
                        </td>
                        <td>
                            @promotion.StartsAt.ToString("dd/MM/yyyy")
                            – @promotion.EndsAt.ToString("dd/MM/yyyy")
                        </td>
                        <td class="num">@row.UsedCount</td>
                        <td>
                            @if (!promotion.IsActive)
                            {
                                <span class="badge badge--muted">Đã tắt</span>
                            }
                            else if (inWindow)
                            {
                                <span class="badge badge--success">Đang chạy</span>
                            }
                            else
                            {
                                <span class="badge badge--muted">Ngoài thời gian</span>
                            }
                        </td>
                        <td>
                            <div class="table-actions">
                                <a asp-page="./Edit" asp-route-id="@promotion.Id" class="btn btn--secondary btn--sm">Sửa</a>
                                <form method="post" asp-page-handler="Toggle" asp-route-id="@promotion.Id">
                                    <button type="submit" class="btn btn--secondary btn--sm">
                                        @(promotion.IsActive ? "Tắt mã" : "Bật mã")
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="empty-state">Chưa có mã khuyến mãi nào. Bấm "Tạo mã mới" để bắt đầu.</p>
    }
</div>
