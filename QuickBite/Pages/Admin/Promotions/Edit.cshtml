@page "{id:int}"
@model QuickBite.Pages.Admin.Promotions.EditModel
@using QuickBite.Models

@{
    ViewData["Title"] = "Sửa mã khuyến mãi";
}

<div class="page-header">
    <h1 class="page-title">Sửa mã @Model.Promotion.Code</h1>
</div>

<div class="form-surface">
    <form method="post">
        <input type="hidden" asp-for="Promotion.Id" />
        <div class="form-grid">
            <div asp-validation-summary="ModelOnly" class="form-error field--wide"></div>

            <div class="field">
                <label asp-for="Promotion.Code" class="label">Mã (chữ in hoa + số)</label>
                <input asp-for="Promotion.Code" class="input" />
                <span asp-validation-for="Promotion.Code" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Promotion.Description" class="label">Mô tả</label>
                <input asp-for="Promotion.Description" class="input" />
                <span asp-validation-for="Promotion.Description" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Promotion.DiscountType" class="label">Kiểu giảm</label>
                <select asp-for="Promotion.DiscountType" class="select">
                    <option value="@DiscountType.Percent">Giảm %</option>
                    <option value="@DiscountType.Amount">Giảm số tiền</option>
                </select>
            </div>

            <div class="field">
                <label asp-for="Promotion.DiscountValue" class="label">Giá trị giảm (% hoặc đ)</label>
                <input asp-for="Promotion.DiscountValue" class="input" />
                <span asp-validation-for="Promotion.DiscountValue" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Promotion.MaxDiscountAmount" class="label">Trần giảm tối đa (đ)</label>
                <input asp-for="Promotion.MaxDiscountAmount" class="input" />
                <p class="field-hint">Bắt buộc với mã giảm %, để trống với mã giảm số tiền.</p>
                <span asp-validation-for="Promotion.MaxDiscountAmount" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Promotion.MinOrderTotal" class="label">Đơn tối thiểu (đ)</label>
                <input asp-for="Promotion.MinOrderTotal" class="input" />
                <span asp-validation-for="Promotion.MinOrderTotal" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Promotion.StartsAt" class="label">Bắt đầu</label>
                <input asp-for="Promotion.StartsAt" class="input" />
                <span asp-validation-for="Promotion.StartsAt" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Promotion.EndsAt" class="label">Kết thúc</label>
                <input asp-for="Promotion.EndsAt" class="input" />
                <span asp-validation-for="Promotion.EndsAt" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Promotion.TotalUsageLimit" class="label">Tổng lượt dùng</label>
                <input asp-for="Promotion.TotalUsageLimit" class="input" />
                <p class="field-hint">Để trống nếu không giới hạn tổng lượt.</p>
                <span asp-validation-for="Promotion.TotalUsageLimit" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Promotion.PerPhoneLimit" class="label">Lượt dùng mỗi SĐT</label>
                <input asp-for="Promotion.PerPhoneLimit" class="input" />
                <span asp-validation-for="Promotion.PerPhoneLimit" class="field-error"></span>
            </div>

            <div class="field">
                <label class="label" for="promotion-active">Trạng thái</label>
                <select asp-for="Promotion.IsActive" id="promotion-active" class="select">
                    <option value="true">Đang bật</option>
                    <option value="false">Đã tắt</option>
                </select>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn--primary">Lưu thay đổi</button>
                <a asp-page="./Index" class="btn btn--secondary">Hủy</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
