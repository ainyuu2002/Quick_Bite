@page
@model QuickBite.Pages.Admin.MenuItems.CreateModel

@{
    ViewData["Title"] = "Thêm món ăn";
}

<h1>Thêm món ăn</h1>

<div class="row">
    <div class="col-md-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="MenuItem.Name" class="form-label">Tên món</label>
                <input asp-for="MenuItem.Name" class="form-control" />
                <span asp-validation-for="MenuItem.Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MenuItem.Description" class="form-label">Mô tả</label>
                <textarea asp-for="MenuItem.Description" class="form-control"></textarea>
                <span asp-validation-for="MenuItem.Description" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MenuItem.Price" class="form-label">Giá (đ)</label>
                <input asp-for="MenuItem.Price" class="form-control" />
                <span asp-validation-for="MenuItem.Price" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MenuItem.ImageUrl" class="form-label">URL hình ảnh</label>
                <input asp-for="MenuItem.ImageUrl" class="form-control" />
                <span asp-validation-for="MenuItem.ImageUrl" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MenuItem.CategoryId" class="form-label">Danh mục</label>
                <select asp-for="MenuItem.CategoryId" asp-items="Model.CategoryList" class="form-select">
                    <option value="">-- Chọn danh mục --</option>
                </select>
                <span asp-validation-for="MenuItem.CategoryId" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Lưu</button>
            <a asp-page="./Index" class="btn btn-secondary">Hủy</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}