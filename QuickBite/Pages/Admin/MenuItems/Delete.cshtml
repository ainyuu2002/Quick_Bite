@page
@model QuickBite.Pages.Admin.MenuItems.DeleteModel

@{
    ViewData["Title"] = "Xóa món ăn";
}

<h1>Xóa món ăn</h1>

<div class="alert alert-warning">
    Bạn có chắc muốn xóa món này? Nếu món đã có trong đơn hàng, hệ thống sẽ từ chối xóa
    và bạn nên dùng nút "Ẩn" ở trang danh sách thay vì xóa.
</div>

<dl class="row">
    <dt class="col-sm-2">Tên món</dt>
    <dd class="col-sm-10">@Model.MenuItem.Name</dd>

    <dt class="col-sm-2">Danh mục</dt>
    <dd class="col-sm-10">@Model.MenuItem.Category?.Name</dd>

    <dt class="col-sm-2">Giá</dt>
    <dd class="col-sm-10">@Model.MenuItem.Price.ToString("N0") đ</dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="MenuItem.Id" />
    <input type="submit" value="Xác nhận xóa" class="btn btn-danger" />
    <a asp-page="./Index" class="btn btn-secondary">Hủy</a>
</form>