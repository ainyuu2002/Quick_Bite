@page
@model QuickBite.Pages.Admin.MenuItems.DeleteModel

@{
    ViewData["Title"] = "Xóa món ăn";
}

<div class="page-header">
    <h1 class="page-title">Xóa món ăn</h1>
</div>

<div class="card card--narrow">
    <div class="alert alert--warning">
        Bạn có chắc muốn xóa món này? Nếu món đã có trong đơn hàng, hệ thống sẽ từ chối xóa
        và bạn nên dùng nút "Ẩn" ở trang danh sách thay vì xóa.
    </div>

    <div class="kv">
        <div class="kv-row">
            <span class="kv-label">Tên món</span>
            <span class="kv-value">@Model.MenuItem.Name</span>
        </div>
        <div class="kv-row">
            <span class="kv-label">Danh mục</span>
            <span class="kv-value">@Model.MenuItem.Category?.Name</span>
        </div>
        <div class="kv-row">
            <span class="kv-label">Giá</span>
            <span class="kv-value">@Model.MenuItem.Price.ToString("N0") đ</span>
        </div>
    </div>

    <form method="post">
        <input type="hidden" asp-for="MenuItem.Id" />
        <div class="form-actions">
            <button type="submit" class="btn btn--danger">Xác nhận xóa</button>
            <a asp-page="./Index" class="btn btn--outline">Hủy</a>
        </div>
    </form>
</div>