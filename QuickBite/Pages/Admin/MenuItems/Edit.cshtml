@page
@model QuickBite.Pages.Admin.MenuItems.EditModel

@{
    ViewData["Title"] = "Sửa món ăn";
}

<div class="page-header">
    <h1 class="page-title">Sửa món ăn</h1>
</div>

<div class="form-surface">
    <form method="post">
        <div class="form-grid">
            <div asp-validation-summary="ModelOnly" class="form-error"></div>
            <input type="hidden" asp-for="MenuItem.Id" />

            <div class="field">
                <label asp-for="MenuItem.Name" class="label">Tên món</label>
                <input asp-for="MenuItem.Name" class="input" />
                <span asp-validation-for="MenuItem.Name" class="field-error"></span>
            </div>

            <div class="field field--wide">
                <label asp-for="MenuItem.Description" class="label">Mô tả</label>
                <textarea asp-for="MenuItem.Description" class="textarea"></textarea>
                <span asp-validation-for="MenuItem.Description" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="MenuItem.Price" class="label">Giá (đ)</label>
                <input asp-for="MenuItem.Price" class="input" />
                <p class="field-hint">Nhập giá lớn hơn 0 đồng.</p>
                <span asp-validation-for="MenuItem.Price" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="MenuItem.CategoryId" class="label">Danh mục</label>
                <select asp-for="MenuItem.CategoryId" asp-items="Model.CategoryList" class="select"></select>
                <span asp-validation-for="MenuItem.CategoryId" class="field-error"></span>
            </div>

            <div class="field field--wide">
                <label asp-for="MenuItem.ImageUrl" class="label">URL hình ảnh</label>
                <input asp-for="MenuItem.ImageUrl" class="input" />
                <span asp-validation-for="MenuItem.ImageUrl" class="field-error"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn--primary">Lưu món</button>
                <a asp-page="./Index" class="btn btn--secondary">Hủy</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
