@page
@model QuickBite.Pages.Admin.Complaints.IndexModel
@using QuickBite.Models

@{
    ViewData["Title"] = "Phản ánh của khách";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Phản ánh của khách</h1>
        <p class="page-description">
            Điểm hài lòng 30 ngày:
            <strong>@(Model.RatingCount == 0 ? "chưa có" : $"{Model.RatingAverage:0.0}/5")</strong>
            (@Model.RatingCount lượt chấm — chỉ nội bộ nhìn thấy)
        </p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert--danger">@Model.ErrorMessage</div>
}

<form method="get" class="toolbar">
    <label class="visually-hidden" for="complaint-status">Trạng thái</label>
    <select id="complaint-status" name="status" class="input">
        <option value="open" selected="@(Model.StatusFilter == "open")">Đang mở</option>
        <option value="resolved" selected="@(Model.StatusFilter == "resolved")">Đã giải quyết</option>
        <option value="all" selected="@(Model.StatusFilter == "all")">Tất cả</option>
    </select>
    <button type="submit" class="btn btn--secondary btn--sm">Lọc</button>
</form>

<div class="data-surface">
    @if (Model.Complaints.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Đơn</th>
                    <th>Vấn đề</th>
                    <th>Nội dung</th>
                    <th>Trạng thái</th>
                    <th>Xử lý</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var complaint in Model.Complaints)
                {
                    <tr>
                        <td>
                            <strong>#@complaint.OrderId</strong>
                            <br /><small>@complaint.Phone</small>
                            <br /><small>@complaint.CreatedAt.ToString("dd/MM HH:mm")</small>
                        </td>
                        <td>@complaint.Category.ToDisplayText()</td>
                        <td>
                            @complaint.Description
                            @if (!string.IsNullOrWhiteSpace(complaint.Resolution))
                            {
                                <br /><small><strong>Phản hồi:</strong> @complaint.Resolution</small>
                            }
                        </td>
                        <td>
                            @if (complaint.Status == ComplaintStatus.New)
                            {
                                <span class="badge badge--muted">Mới</span>
                            }
                            else if (complaint.Status == ComplaintStatus.InProgress)
                            {
                                <span class="badge badge--success">Đang xử lý</span>
                            }
                            else
                            {
                                <span class="badge badge--success">Đã giải quyết</span>
                            }
                        </td>
                        <td>
                            @if (complaint.Status == ComplaintStatus.New)
                            {
                                <form method="post" asp-page-handler="Start" asp-route-id="@complaint.Id">
                                    <button type="submit" class="btn btn--secondary btn--sm">Tiếp nhận</button>
                                </form>
                            }
                            else if (complaint.Status == ComplaintStatus.InProgress)
                            {
                                <form method="post" asp-page-handler="Resolve" asp-route-id="@complaint.Id"
                                      class="table-actions">
                                    <label class="visually-hidden" for="resolution-@complaint.Id">Phản hồi</label>
                                    <input id="resolution-@complaint.Id" name="resolution" class="input"
                                           placeholder="Phản hồi cho khách..." required />
                                    <button type="submit" class="btn btn--primary btn--sm">Đóng</button>
                                </form>
                            }
                            else
                            {
                                <small>@complaint.ResolvedAt?.ToString("dd/MM HH:mm")</small>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="empty-state">Không có phản ánh nào trong bộ lọc này.</p>
    }
</div>
