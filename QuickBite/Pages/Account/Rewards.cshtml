@page "/Account/Rewards"
@namespace QuickBite.Pages.CustomerAccount
@model QuickBite.Pages.CustomerAccount.RewardsModel
@using QuickBite.Models
@{
    ViewData["Title"] = "Điểm & Voucher";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Điểm & Voucher</h1>
        <p class="text-muted mb-0">
            Mỗi 10.000đ trên đơn hoàn tất = 1 điểm. Đổi điểm lấy voucher giảm giá.
        </p>
    </div>
    <a asp-page="/Account/Index" class="btn btn-outline-secondary">Về trang tài khoản</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="text-muted">Số dư điểm hiện tại</span>
                <div class="display-6 fw-bold text-primary">@Model.PointBalance điểm</div>
            </div>
        </div>

        <hr />

        <h2 class="h5 mb-3">Đổi điểm lấy voucher</h2>
        <div class="row g-3">
            @foreach (var option in Model.Options)
            {
                var affordable = Model.PointBalance >= option.Points;
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100 d-flex flex-column @(affordable ? "" : "opacity-50")">
                        <div class="h4 mb-1">Giảm @option.Percent%</div>
                        <div class="text-muted small mb-3">
                            Tối đa @option.MaxDiscount.ToString("N0") đ · hạn 30 ngày
                        </div>
                        <form method="post" asp-page-handler="Redeem" class="mt-auto">
                            <input type="hidden" name="option" value="@option.Key" />
                            <button type="submit" class="btn btn-primary w-100"
                                    disabled="@(affordable ? null : "disabled")">
                                Đổi @option.Points điểm
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold">Voucher của bạn</div>
            <div class="card-body p-0">
                @if (Model.Vouchers.Count == 0)
                {
                    <p class="text-muted p-3 mb-0">Chưa có voucher nào. Đổi điểm để nhận voucher.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Mã</th>
                                    <th>Ưu đãi</th>
                                    <th>Hạn dùng</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var voucher in Model.Vouchers)
                                {
                                    <tr>
                                        <td><code>@voucher.Code</code></td>
                                        <td>@voucher.DiscountPercent% (tối đa @voucher.MaxDiscountAmount.ToString("N0") đ)</td>
                                        <td>@voucher.ExpiresAt.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @if (voucher.UsedAt is not null)
                                            {
                                                <span class="badge bg-secondary">Đã dùng</span>
                                            }
                                            else if (voucher.ExpiresAt < DateTime.Now)
                                            {
                                                <span class="badge bg-danger">Hết hạn</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Chưa dùng</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold">Lịch sử điểm</div>
            <div class="card-body p-0">
                @if (Model.Ledger.Count == 0)
                {
                    <p class="text-muted p-3 mb-0">
                        Chưa có biến động điểm. Điểm được cộng khi đơn hoàn tất.
                    </p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Thời gian</th>
                                    <th>Loại</th>
                                    <th>Nội dung</th>
                                    <th class="text-end">Điểm</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in Model.Ledger)
                                {
                                    <tr>
                                        <td>@entry.CreatedAt.ToString("dd/MM HH:mm")</td>
                                        <td>@entry.Type.ToDisplayText()</td>
                                        <td class="text-muted">@entry.Note</td>
                                        <td class="text-end fw-semibold @(entry.Points >= 0 ? "text-success" : "text-danger")">
                                            @(entry.Points >= 0 ? "+" : "")@entry.Points
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
