@page "/Account"
@namespace QuickBite.Pages.CustomerAccount
@model QuickBite.Pages.CustomerAccount.IndexModel
@{
    ViewData["Title"] = "Tài khoản của tôi";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Xin chào, @Model.Customer.FullName</h1>
        <p class="text-muted mb-0">
            Thành viên từ @Model.Customer.CreatedAt.ToString("dd/MM/yyyy")
            @if (Model.Badge.IsLoyal)
            {
                <span class="badge bg-warning text-dark ms-2">
                    ⭐ Khách quen · @Model.Badge.CompletedCount đơn trong 90 ngày
                </span>
            }
        </p>
    </div>
    <form method="post" asp-page-handler="Logout">
        <button type="submit" class="btn btn-outline-secondary">Đăng xuất</button>
    </form>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

<div class="row g-4">
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body p-4 text-center">
                <span class="text-muted">Điểm tích lũy</span>
                <div class="display-5 fw-bold text-primary my-2">@Model.PointBalance</div>
                <a asp-page="/Account/Rewards" class="btn btn-primary w-100">Đổi voucher</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body p-4 text-center">
                <span class="text-muted">Đơn hoàn tất (90 ngày)</span>
                <div class="display-5 fw-bold my-2">@Model.Badge.CompletedCount</div>
                <a asp-page="/Account/Orders" class="btn btn-outline-primary w-100">Lịch sử đơn hàng</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body p-4 text-center">
                <span class="text-muted">Số điện thoại</span>
                <div class="h3 my-3">@Model.Customer.Phone</div>
                <a asp-page="/Menu/Index" class="btn btn-outline-primary w-100">Đặt món ngay</a>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mt-4">
    <div class="card-body p-4">
        <h2 class="h4 mb-3">Thông tin tài khoản</h2>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.FullName" class="form-label"></label>
                <input asp-for="Input.FullName" class="form-control" autocomplete="name" />
                <span asp-validation-for="Input.FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.SavedAddress" class="form-label"></label>
                <textarea asp-for="Input.SavedAddress" class="form-control" rows="3"
                          placeholder="Địa chỉ sẽ được điền sẵn mỗi lần đặt hàng"></textarea>
                <span asp-validation-for="Input.SavedAddress" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
