@page "/Checkout"
@model QuickBite.Pages.Checkout.IndexModel
@{
    ViewData["Title"] = "Thanh toán";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Thông tin đặt hàng</h1>
        <p class="text-muted mb-0">Kiểm tra đơn và nhập thông tin liên hệ để hoàn tất.</p>
    </div>
    <a asp-page="/Cart/Index" class="btn btn-outline-secondary">Quay lại giỏ hàng</a>
</div>

@if (Model.Cart.Count == 0)
{
    <div class="text-center border rounded p-5 bg-light">
        <h2 class="h4">Chưa có món để thanh toán</h2>
        <p class="text-muted">Hãy thêm món ăn vào giỏ trước khi đặt hàng.</p>
        <a asp-page="/Menu/Index" class="btn btn-primary">Xem thực đơn</a>
    </div>
}
else
{
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <h2 class="h4 mb-3">Thông tin khách hàng</h2>

                        <div class="mb-3">
                            <label asp-for="Input.CustomerName" class="form-label"></label>
                            <input asp-for="Input.CustomerName" class="form-control" autocomplete="name" />
                            <span asp-validation-for="Input.CustomerName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Phone" class="form-label"></label>
                            <input asp-for="Input.Phone" class="form-control" inputmode="tel" autocomplete="tel" />
                            <span asp-validation-for="Input.Phone" class="text-danger"></span>
                        </div>

                        <fieldset class="mb-3">
                            <label asp-for="Input.OrderType" class="form-label"></label>
                            <div class="d-flex gap-3">
                                <label class="order-type-option">
                                    <input asp-for="Input.OrderType" type="radio"
                                           value="@QuickBite.Models.OrderType.Delivery" data-order-type />
                                    <span>Giao hàng</span>
                                </label>
                                <label class="order-type-option">
                                    <input asp-for="Input.OrderType" type="radio"
                                           value="@QuickBite.Models.OrderType.Pickup" data-order-type />
                                    <span>Nhận tại quán</span>
                                </label>
                            </div>
                        </fieldset>

                        <div class="mb-3" id="address-block">
                            <label asp-for="Input.Address" class="form-label"></label>
                            <textarea asp-for="Input.Address" class="form-control" rows="3"
                                      autocomplete="street-address"
                                      placeholder="Số nhà, tên đường, phường/xã, quận/huyện..."></textarea>
                            <span asp-validation-for="Input.Address" class="text-danger"></span>
                        </div>

                        <div class="mb-0">
                            <label asp-for="Input.Note" class="form-label"></label>
                            <textarea asp-for="Input.Note" class="form-control" rows="4"
                                      placeholder="Ví dụ: ít cay, không hành..."></textarea>
                            <span asp-validation-for="Input.Note" class="text-danger"></span>
                        </div>

                        <fieldset class="mt-4">
                            <legend class="h5">Phương thức thanh toán</legend>
                            <div class="payment-method-options">
                                <label class="payment-method-option">
                                    <input asp-for="Input.PaymentMethod" type="radio"
                                           value="@QuickBite.Models.PaymentMethod.Cash" />
                                    <span>
                                        <strong>Tiền mặt</strong>
                                        <small>Thanh toán trực tiếp khi nhận món</small>
                                    </span>
                                </label>
                                <label class="payment-method-option">
                                    <input asp-for="Input.PaymentMethod" type="radio"
                                           value="@QuickBite.Models.PaymentMethod.BankTransfer" />
                                    <span>
                                        <strong>Chuyển khoản</strong>
                                        <small>Chuyển khoản theo hướng dẫn của quán</small>
                                    </span>
                                </label>
                            </div>
                            <span asp-validation-for="Input.PaymentMethod" class="text-danger"></span>
                        </fieldset>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card shadow-sm checkout-summary">
                    <div class="card-body p-4">
                        <h2 class="h4 mb-3">Đơn hàng của bạn</h2>
                        <ul class="list-group list-group-flush mb-3">
                            @foreach (var item in Model.Cart)
                            {
                                <li class="list-group-item px-0 d-flex justify-content-between gap-3">
                                    <span>@item.Name <span class="text-muted">× @item.Quantity</span></span>
                                    <strong class="text-nowrap">@item.Subtotal.ToString("N0") đ</strong>
                                </li>
                            }
                        </ul>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Tổng số lượng</span>
                            <strong>@Model.TotalQuantity</strong>
                        </div>
                        <div class="d-flex justify-content-between fs-4 border-top pt-3">
                            <span>Tổng cộng</span>
                            <strong class="text-primary">@Model.Total.ToString("N0") đ</strong>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 mt-4">
                            Xác nhận đặt hàng
                        </button>
                        <p class="small text-muted text-center mt-2 mb-0">
                            Giá và tình trạng món sẽ được kiểm tra lại khi xác nhận.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const addressBlock = document.getElementById('address-block');
            const radios = document.querySelectorAll('[data-order-type]');

            if (!addressBlock || radios.length === 0) {
                return;
            }

            const sync = () => {
                const pickupSelected = Array.from(radios)
                    .some(radio => radio.checked && radio.value === 'Pickup');
                addressBlock.hidden = pickupSelected;
            };

            radios.forEach(radio => radio.addEventListener('change', sync));
            sync();
        })();
    </script>
}
