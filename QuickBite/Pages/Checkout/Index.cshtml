@page "/Checkout"
@model QuickBite.Pages.Checkout.IndexModel
@{
    ViewData["Title"] = "Thanh toán";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Thông tin đặt hàng</h1>
        <p class="text-muted mb-0">Kiểm tra đơn và nhập thông tin liên hệ để hoàn tất.</p>
    </div>
    <a asp-page="/Cart/Index" class="btn btn-outline-secondary">Quay lại giỏ hàng</a>
</div>

@if (Model.Cart.Count == 0)
{
    <div class="text-center border rounded p-5 bg-light">
        <h2 class="h4">Chưa có món để thanh toán</h2>
        <p class="text-muted">Hãy thêm món ăn vào giỏ trước khi đặt hàng.</p>
        <a asp-page="/Menu/Index" class="btn btn-primary">Xem thực đơn</a>
    </div>
}
else
{
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <h2 class="h4 mb-3">Thông tin khách hàng</h2>

                        <div class="mb-3">
                            <label asp-for="Input.CustomerName" class="form-label"></label>
                            <input asp-for="Input.CustomerName" class="form-control" autocomplete="name" />
                            <span asp-validation-for="Input.CustomerName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Phone" class="form-label"></label>
                            <input asp-for="Input.Phone" class="form-control" inputmode="tel" autocomplete="tel" />
                            <span asp-validation-for="Input.Phone" class="text-danger"></span>
                        </div>

                        <fieldset class="mb-3">
                            <label asp-for="Input.OrderType" class="form-label"></label>
                            <div class="d-flex gap-3">
                                <label class="order-type-option">
                                    <input asp-for="Input.OrderType" type="radio"
                                           value="@QuickBite.Models.OrderType.Delivery" data-order-type />
                                    <span>Giao hàng</span>
                                </label>
                                <label class="order-type-option">
                                    <input asp-for="Input.OrderType" type="radio"
                                           value="@QuickBite.Models.OrderType.Pickup" data-order-type />
                                    <span>Nhận tại quán</span>
                                </label>
                            </div>
                        </fieldset>

                        <div class="mb-3" id="address-block">
                            <label asp-for="Input.Address" class="form-label"></label>
                            <textarea asp-for="Input.Address" class="form-control" rows="3"
                                      autocomplete="street-address"
                                      placeholder="Số nhà, tên đường, phường/xã, quận/huyện..."></textarea>
                            <span asp-validation-for="Input.Address" class="text-danger"></span>
                        </div>

                        @if (Model.IsParty)
                        {
                            <div class="alert alert-warning">
                                <strong>Đơn đặt tiệc</strong> (trên @Model.PartyThreshold.ToString("N0")đ tiền món):
                                cần hẹn giờ nhận trước tối thiểu @Model.PartyMinLeadHours giờ và đặt cọc
                                @Model.PartyDepositPercent% (~@Model.EstimatedDeposit.ToString("N0")đ).
                                Quán sẽ xét duyệt trước khi nhận đơn.
                            </div>
                            <div class="mb-3">
                                <label asp-for="Input.ScheduledFor" class="form-label"></label>
                                <input asp-for="Input.ScheduledFor" type="datetime-local" class="form-control" />
                                <span asp-validation-for="Input.ScheduledFor" class="text-danger"></span>
                            </div>
                        }

                        <div class="mb-0">
                            <label asp-for="Input.Note" class="form-label"></label>
                            <textarea asp-for="Input.Note" class="form-control" rows="4"
                                      placeholder="Ví dụ: ít cay, không hành..."></textarea>
                            <span asp-validation-for="Input.Note" class="text-danger"></span>
                        </div>

                        <fieldset class="mt-4">
                            <legend class="h5">Phương thức thanh toán</legend>
                            <div class="payment-method-options">
                                <label class="payment-method-option">
                                    <input asp-for="Input.PaymentMethod" type="radio"
                                           value="@QuickBite.Models.PaymentMethod.Cash" />
                                    <span>
                                        <strong>Tiền mặt</strong>
                                        <small>Thanh toán trực tiếp khi nhận món</small>
                                    </span>
                                </label>
                                <label class="payment-method-option">
                                    <input asp-for="Input.PaymentMethod" type="radio"
                                           value="@QuickBite.Models.PaymentMethod.BankTransfer" />
                                    <span>
                                        <strong>Chuyển khoản</strong>
                                        <small>Chuyển khoản theo hướng dẫn của quán</small>
                                    </span>
                                </label>
                            </div>
                            <span asp-validation-for="Input.PaymentMethod" class="text-danger"></span>
                        </fieldset>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card shadow-sm checkout-summary">
                    <div class="card-body p-4">
                        <h2 class="h4 mb-3">Đơn hàng của bạn</h2>
                        <ul class="list-group list-group-flush mb-3">
                            @foreach (var item in Model.Cart)
                            {
                                <li class="list-group-item px-0 d-flex justify-content-between gap-3">
                                    <span>@item.Name <span class="text-muted">× @item.Quantity</span></span>
                                    <strong class="text-nowrap">@item.Subtotal.ToString("N0") đ</strong>
                                </li>
                            }
                        </ul>

                        <div class="border-top pt-3 mb-3">
                            <div class="mb-2">
                                <label asp-for="Input.PromotionCode" class="form-label small mb-1"></label>
                                <input asp-for="Input.PromotionCode" class="form-control form-control-sm text-uppercase"
                                       placeholder="Nhập mã nếu có" />
                                <span asp-validation-for="Input.PromotionCode" class="text-danger"></span>
                            </div>
                            <div class="mb-1">
                                <label asp-for="Input.VoucherCode" class="form-label small mb-1"></label>
                                <input asp-for="Input.VoucherCode" class="form-control form-control-sm text-uppercase"
                                       placeholder="Ví dụ: QV-ABC123" autocomplete="off" />
                                <span asp-validation-for="Input.VoucherCode" class="text-danger"></span>
                                @if (Model.AvailableVouchers.Count > 0)
                                {
                                    <div class="mt-2" data-voucher-suggestions>
                                        <small class="text-muted d-block mb-1">
                                            Voucher của bạn — bấm để dùng:
                                        </small>
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var voucher in Model.AvailableVouchers)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-success"
                                                        data-voucher-code="@voucher.Code"
                                                        title="Hết hạn @voucher.ExpiresAt.ToString("dd/MM/yyyy")">
                                                    @voucher.Code · @voucher.DiscountPercent%
                                                    (tối đa @voucher.MaxDiscountAmount.ToString("N0") đ)
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            <p class="small text-muted mb-0">
                                Mỗi đơn chỉ áp dụng một mã. Giảm giá được trừ khi xác nhận đặt hàng.
                            </p>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Tổng số lượng</span>
                            <strong>@Model.TotalQuantity</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tiền món</span>
                            <strong>@Model.Total.ToString("N0") đ</strong>
                        </div>
                        <div class="d-flex justify-content-between fs-5 border-top pt-3">
                            <span>Tổng cộng (chưa gồm phí giao)</span>
                            <strong class="text-primary">@Model.Total.ToString("N0") đ</strong>
                        </div>

                        @if (Model.IsMember && Model.PotentialPoints > 0)
                        {
                            <p class="small text-success mt-2 mb-0">
                                Đơn này sẽ tích khoảng @Model.PotentialPoints điểm khi hoàn tất.
                            </p>
                        }

                        <button type="submit" class="btn btn-primary btn-lg w-100 mt-4">
                            Xác nhận đặt hàng
                        </button>
                        <p class="small text-muted text-center mt-2 mb-0">
                            Đơn giao hàng cộng phí giao @Model.DeliveryFee.ToString("N0") đ,
                            tối thiểu @Model.MinimumDeliverySubtotal.ToString("N0") đ tiền món.
                            Hóa đơn cuối hiển thị ở trang tra cứu.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const addressBlock = document.getElementById('address-block');
            const radios = document.querySelectorAll('[data-order-type]');

            if (!addressBlock || radios.length === 0) {
                return;
            }

            const sync = () => {
                const pickupSelected = Array.from(radios)
                    .some(radio => radio.checked && radio.value === 'Pickup');
                addressBlock.hidden = pickupSelected;
            };

            radios.forEach(radio => radio.addEventListener('change', sync));
            sync();
        })();

        (() => {
            const container = document.querySelector('[data-voucher-suggestions]');
            const voucherInput = document.getElementById('Input_VoucherCode');
            const promotionInput = document.getElementById('Input_PromotionCode');

            if (!container || !voucherInput) {
                return;
            }

            container.querySelectorAll('[data-voucher-code]').forEach(button => {
                button.addEventListener('click', () => {
                    voucherInput.value = button.dataset.voucherCode;
                    if (promotionInput) {
                        promotionInput.value = '';
                    }
                    voucherInput.focus();
                });
            });
        })();
    </script>
}
